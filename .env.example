# 複製此檔為 .env 並填入實際值：cp .env.example .env
# DB_USERNAME 目前需為 root（compose 只設定了 MySQL 的 root 密碼）
DB_USERNAME=root
# DB_PASSWORD 必填：MySQL 容器的 root 密碼（第一次建立資料庫時設定），webapp 也用它連線
DB_PASSWORD=

# 本機對外 port（可依需要修改，留空則使用 compose 中的預設值）
MYSQL_PORT=13306
REDIS_PORT=16379
ADMINER_PORT=18080
WEBAPP_PORT=18088

# 綠界刷卡（必填，值不要 commit）：商店代號、HashKey、HashIV、付款網址
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_PAY_URL=
# 綠界付款完成回呼網址：VM 對外網址 + 路徑（不能是 localhost）
ECPAY_RETURN_URL=
# 候位 QR Code 網址：VM 對外網址 + 路徑（不能是 localhost）
WAITING_JOIN_URL=
